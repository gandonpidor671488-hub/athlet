<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Athlet.App">
  <Application.Resources>
    <Color x:Key="Accent">#FF5A1F</Color>
    <Color x:Key="Dark">#111418</Color>
    <Color x:Key="Card">#1E232A</Color>
    <Color x:Key="Muted">#9AA4B2</Color>
    <Style TargetType="Page" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="{StaticResource Dark}"/></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="White"/></Style>
    <Style TargetType="Entry"><Setter Property="TextColor" Value="White"/><Setter Property="PlaceholderColor" Value="{StaticResource Muted}"/></Style>
    <Style TargetType="SearchBar"><Setter Property="TextColor" Value="White"/><Setter Property="PlaceholderColor" Value="{StaticResource Muted}"/></Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="BackgroundColor" Value="{StaticResource Accent}"/><Setter Property="TextColor" Value="White"/>
      <Setter Property="CornerRadius" Value="14"/><Setter Property="HeightRequest" Value="52"/><Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style x:Key="Mini" TargetType="Button">
      <Setter Property="BackgroundColor" Value="#2A313B"/><Setter Property="TextColor" Value="White"/>
      <Setter Property="WidthRequest" Value="40"/><Setter Property="HeightRequest" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/>
    </Style>
    <DataTemplate x:Key="Chip">
      <Border Padding="16,0" HeightRequest="40" StrokeShape="RoundRectangle 20" Stroke="Transparent" BackgroundColor="{StaticResource Card}">
        <VisualStateManager.VisualStateGroups><VisualStateGroupList><VisualStateGroup Name="CommonStates">
          <VisualState Name="Normal"/>
          <VisualState Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource Accent}"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateGroupList></VisualStateManager.VisualStateGroups>
        <Label Text="{Binding .}" VerticalOptions="Center"/>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ProductCard">
      <Border Padding="12" Margin="4" StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{StaticResource Card}">
        <VerticalStackLayout Spacing="4">
          <Border BackgroundColor="#2A313B" HeightRequest="90" StrokeShape="RoundRectangle 12" Stroke="Transparent">
            <Label Text="{Binding Emoji}" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center"/>
          </Border>
          <Label Text="{Binding Brand}" TextColor="{StaticResource Muted}" FontSize="11"/>
          <Label Text="{Binding Name}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation"/>
          <Label Text="{Binding Weight}" TextColor="{StaticResource Muted}" FontSize="12"/>
          <Label Text="{Binding PriceText}" TextColor="{StaticResource Accent}" FontAttributes="Bold" FontSize="16"/>
        </VerticalStackLayout>
      </Border>
    </DataTemplate>
  </Application.Resources>
</Application>
