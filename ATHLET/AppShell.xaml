<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Athlet" x:Class="Athlet.AppShell"
       Shell.BackgroundColor="{StaticResource Dark}" Shell.TitleColor="White" Shell.ForegroundColor="White"
       Shell.TabBarBackgroundColor="{StaticResource Card}" Shell.TabBarTitleColor="{StaticResource Accent}" Shell.TabBarUnselectedColor="{StaticResource Muted}">
  <TabBar>
    <ShellContent Title="🏠 Главная" Route="home" ContentTemplate="{DataTemplate local:HomePage}"/>
    <ShellContent Title="🛍 Каталог" Route="catalog" ContentTemplate="{DataTemplate local:CatalogPage}"/>
    <ShellContent Title="🛒 Корзина" Route="cart" ContentTemplate="{DataTemplate local:CartPage}"/>
    <ShellContent Title="ℹ️ Инфо" Route="info" ContentTemplate="{DataTemplate local:InfoPage}"/>
  </TabBar>
</Shell>
